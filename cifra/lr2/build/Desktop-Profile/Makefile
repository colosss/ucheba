####### Compile

main.o: ../../main.cpp ../../mainwindow.h \
		../../myopenglwidget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		../../myopenglwidget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../../mainwindow.cpp

myopenglwidget.o: ../../myopenglwidget.cpp ../../myopenglwidget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o myopenglwidget.o ../../myopenglwidget.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_myopenglwidget.o: moc_myopenglwidget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_myopenglwidget.o moc_myopenglwidget.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/lr2/bin || mkdir -p $(INSTALL_ROOT)/opt/lr2/bin
	$(QINSTALL) /home/mifugi/cifra/lr2/build/Desktop-Profile/lr2.debug $(INSTALL_ROOT)/opt/lr2/bin/lr2.debug
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/lr2/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/lr2/bin/lr2.debug 
	 -$(DEL_FILE) $(INSTALL_ROOT)/opt/lr2/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/lr2/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

